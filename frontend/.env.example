# Leave empty to use the Vercel API hosted on the same domain.
VITE_API_BASE_URL=
# Server-only AI settings. Use a Google project on the Free tier to avoid charges.
# Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Never prefix API keys with VITE_.

# Server-only PostgreSQL storage for accounts, profiles, workouts and progress.
# Set this in Vercel too. Never prefix it with VITE_.
DATABASE_URL=postgresql://127.0.0.1:5433/hoopflow_ai
